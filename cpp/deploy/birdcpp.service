[Unit]
Description=birdcpp - C birdboard, all-on-board bird detection (TI SK-AM62)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/root/birdcpp
# live-media-only design: birdboard (python, continuous capture) may still
# fight over the camera, so it is stopped before start; but it is NOT
# auto-started on stop anymore - with gated capture there is no hand-back.
# Start birdboard manually if the python board is wanted again.
ExecStartPre=/bin/sh -c 'systemctl stop birdboard 2>/dev/null; true'
ExecStartPre=/bin/sh -c 'pkill -f "frame[p]umper" 2>/dev/null; true'
ExecStart=/home/root/birdcpp/birdcpp -p 8888 -m /home/root/birdcpp/best_448.onnx --img 448
# model history (all three onnx stay deployed in /home/root/birdcpp):
#   best.onnx     640 - original (cycle ~1810 ms, mAP50 0.832)
#   best_448.onnx 448 - promoted 2026-11-10 from OPTION-A trial
#                       (cycle 2830->~1090 ms live, mAP50 0.806)
#   best_448.onnx 448 - RUNNING since 2026-11-10 (user preference):
#                       balanced pick (~790-1190 ms cycles, mAP50 0.806)
#   best_384.onnx 384 - speed-first: ran on :8888 briefly (~720 ms cycles,
#                       mAP50 0.767, recalls ~6% fewer birds than 448)
# switching (since 2026-11-16): the dashboard has a live model toggle
#   (/model + /model-set endpoints) - no unit edit needed for a switch.
#   -m/--img here is only the BOOT default; a dashboard choice is persisted
#   to /home/root/birdcpp/model_sel_8888.txt and wins until that file is
#   removed. The letterbox auto-follows the model's static input size.
#   candidates: /home/root/birdcpp/*.onnx + /home/root/birdcpp-scratch/*.onnx
# manual fallback (restart required):
#   ExecStart=/home/root/birdcpp/birdcpp -p 8888 -m /home/root/birdcpp/best_448.onnx --img 448
#   ExecStart=/home/root/birdcpp/birdcpp -p 8888                (640 default)
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
